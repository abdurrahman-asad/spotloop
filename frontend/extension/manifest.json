{
  "manifest_version": 3,
  "name": "Spotloop",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "description": "Drop a spot. Loop in your team.",
  "action": { "default_title": "Spotloop" },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "sw.ts"
  },
  "content_scripts": [
    {
      "js": ["src/content.ts"],
      "matches": ["https://www.google.com/*"]
    }
  ],
  "permissions": ["sidePanel"]
}
